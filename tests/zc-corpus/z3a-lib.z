// Z3a (issue #758): the "module" half of the multi-file pair. Compiled
// together with z3a-multifile.z into ONE flat cross-file symbol table — no
// @import between the files (the ladder's module system is scope-out for this
// step; Z3b's stdz rides this table). Valid Zig 0.17 on its own and when
// concatenated with the main half.
fn lib_triple(x: u64) u64 {
    return x * 3;
}

fn lib_double(x: u64) u64 {
    return x * 2;
}

fn lib_combo(x: u64) u64 {
    // A same-file call inside the module: exercises the table + patch
    // machinery within one unit before the cross-file calls from main.
    return lib_triple(x) + lib_double(x);
}